[
  verbose: false,
  private: false,
  # skip: true honors per-function `# sobelow_skip ["Rule"]` annotations. Each
  # sits on the smallest function holding the flagged call, with its reason.
  skip: true,
  exit: "low",
  format: "txt",
  out: "",
  threshold: "low",
  # Config.HTTPS — graph_conn is a client library plus a small Plug+Cowboy
  # test endpoint. It never terminates TLS itself; production callers run
  # behind TLS-terminating ingress. Router-based checks (Config.CSRFRoute)
  # are skipped with no router; XSS.SendResp runs on the mock router.
  ignore: ["Config.HTTPS"],
  ignore_files: []
]
